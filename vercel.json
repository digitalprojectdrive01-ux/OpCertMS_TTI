{
  "version": 2,
  "routes": [
    { "src": "/api/auth",   "dest": "/api/auth.js"   },
    { "src": "/api/verify", "dest": "/api/verify.js" },
    { "src": "/api/db",     "dest": "/api/db.js"     },
    { "src": "/api/(.*)",   "dest": "/api/$1"        },
    { "src": "/(.*)",       "dest": "/index.html"    }
  ]
}
